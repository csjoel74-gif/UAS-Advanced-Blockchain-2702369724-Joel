async function connectWallet() {
  if (!window.ethereum) {
    alert("Install MetaMask");
    return;
  }

  web3 = new Web3(window.ethereum);
  await ethereum.request({ method: "eth_requestAccounts" });

  const accounts = await web3.eth.getAccounts();
  document.getElementById("account").innerText = accounts[0];

  contract = new web3.eth.Contract(ABI, CONTRACT_ADDRESS);
}


async function registerDriver() {
  const name = driverName.value;
  const fareEth = driverFare.value;

  const accounts = await web3.eth.getAccounts();

  await contract.methods
    .registerDriver(name, web3.utils.toWei(fareEth, "ether"))
    .send({ from: accounts[0] });

  alert("Driver registered");
}

async function acceptRide() {
  const accounts = await web3.eth.getAccounts();

  await contract.methods
    .acceptRide(rideIdDriver.value)
    .send({ from: accounts[0] });

  alert("Ride accepted");
}

async function completeRide() {
  const accounts = await web3.eth.getAccounts();

  await contract.methods
    .completeRide(rideIdDriver.value)
    .send({ from: accounts[0] });

  alert("Ride completed by driver");
}

async function requestRide() {
  const accounts = await web3.eth.getAccounts();

  await contract.methods
    .requestRide(pickup.value, destination.value)
    .send({ from: accounts[0] });

  alert("Ride requested");
}

async function fundRide() {
  const accounts = await web3.eth.getAccounts();

  const ride = await contract.methods
    .rides(rideIdRider.value)
    .call();

  await contract.methods
    .fundRide(rideIdRider.value)
    .send({
      from: accounts[0],
      value: ride.price
    });

  alert("Ride funded");
}

async function confirmArrival() {
  const accounts = await web3.eth.getAccounts();

  await contract.methods
    .confirmArrival(rideIdRider.value)
    .send({ from: accounts[0] });

  alert("Ride finalized");
}
